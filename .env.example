# Claude API（要約の生成）
ANTHROPIC_API_KEY=
# 省略時は claude-opus-5-5
CLAUDE_MODEL=

# OpenAI（Embedding）。※クライアント情シスへの追加確認事項（提案書 6. 参照）
OPENAI_API_KEY=

# Supabase（案件7用に新規作成したプロジェクト。リージョンは東京）
SUPABASE_URL=
# サービスロールキー：取り込み・ユーザー管理・ログ用。検索には使わない（RLSが効かないため）
SUPABASE_SERVICE_ROLE_KEY=
# anon（publishable）キー：質問者本人として検索するクライアント用
SUPABASE_ANON_KEY=

# Slack（Slack連携の実装時に設定）
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Vercel Cron → /api/cron/ingest の認証用（openssl rand -hex 32 で生成）
CRON_SECRET=

# 管理者への通知先（定期取り込みの結果と、監査ログの月次レポート）。SlackのチャンネルIDまたはユーザーID（任意。空なら通知しない）
INGEST_NOTIFY_CHANNEL=
